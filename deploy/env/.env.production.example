GEO_APP_HOST=0.0.0.0
GEO_APP_PORT=5000
GEO_SECRET_KEY=replace-with-long-random-secret

GEO_ADMIN_USERNAME=admin
GEO_ADMIN_PASSWORD=replace-with-strong-password

GEO_DEFAULT_MODEL=deepseek
GEO_SQL_ECHO=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/geo_optimizer

DEEPSEEK_USE_MOCK=false
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_MODEL_NAME=deepseek-chat

DOUBAO_USE_MOCK=false
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=replace-with-doubao-key
DOUBAO_MODEL_NAME=replace-with-endpoint-or-model
