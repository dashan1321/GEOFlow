[Unit]
Description=GEO Optimizer Web Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/geo-optimizer
EnvironmentFile=/opt/geo-optimizer/.env
ExecStart=/opt/geo-optimizer/.venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
